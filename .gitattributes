# GitHub Pages output must be served as real browser files, not LFS pointers.
/apps/arma-el-presupuesto-de-el-salvador/public/*.ico -filter -diff -merge -text
/apps/arma-el-presupuesto-de-el-salvador/public/*.png -filter -diff -merge -text
/arma-el-presupuesto-de-el-salvador/*.ico -filter -diff -merge -text
/arma-el-presupuesto-de-el-salvador/*.png -filter -diff -merge -text
/arma-el-presupuesto-de-el-salvador/assets/*.png -filter -diff -merge -text
/arma-el-presupuesto-de-el-salvador/assets/*.webp -filter -diff -merge -text

